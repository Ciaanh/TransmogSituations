{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Edit|Write",
                "hooks": [
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/lua-check.sh\"", "if": "Edit(**/*.lua)", "timeout": 30 },
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/toc-check.sh\"", "if": "Edit(**/*.toc)", "timeout": 30 }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-tests.sh\"", "timeout": 180 }
                ]
            }
        ]
    },
    "permissions": {
        "allow": [
            "Bash(./tests/run.sh)",
            "Bash(bash tests/run.sh)",
            "Bash(gh run list *)",
            "Bash(gh run view *)",
            "Bash(gh run watch *)"
        ],
        "ask": [
            "Bash(git push origin v*)",
            "Bash(git push --force*)",
            "Bash(git push -f*)",
            "Bash(gh pr merge *)",
            "Bash(gh release *)"
        ]
    }
}
